[Unit]
Description=clixz privileged admin daemon (create / update / archive)
Documentation=file:/opt/repos/clixz/deploy/README.md
Requires=clixz-admind.socket
After=clixz-admind.socket

[Service]
Type=simple
# Root is genuinely required: create and archive chown to the svc_* accounts and
# set ACLs (CAP_CHOWN + CAP_FOWNER). The capability set below is narrowed to
# exactly that, so "root" here is far from full root.
# /usr/local/bin is root:root 755, so this stays a trustworthy target whichever
# installer put it there (pipx, uv, pip). Pointing at an installer-specific venv
# path instead would silently break the unit the day the installer changes.
ExecStart=/usr/local/bin/clixz-admind
Environment=PYTHONUNBUFFERED=1
# The only uid allowed to drive this daemon. Must match the account running
# clixz-runnerd; set it after creating svc_mcprun.
Environment=CLIXZ_ADMIN_ALLOWED_UID=993

# Stop when idle: the root process only exists while work is in flight.
# (Remove if you would rather keep it resident.)
# RuntimeMaxSec=

CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE
AmbientCapabilities=
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# The daemon writes only where services live and where it logs. /etc/clixz stays
# read-only: it must never rewrite the rules it enforces.
ReadWritePaths=/srv/docker /var/log
ReadOnlyPaths=/etc/clixz

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
