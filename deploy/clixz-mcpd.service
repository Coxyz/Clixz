[Unit]
Description=clixz gateway for the MCP server (read-only; mutations are planned, never applied)
After=network.target

[Service]
Type=simple
# Unprivileged, and it must stay that way. v1 paired this daemon with a root one
# holding CAP_DAC_OVERRIDE; the audit of 2026-08-29 found the MCP container was
# published on the internet, which made that pair a path from the internet to
# host root. There is no privileged half any more: mutating verbs are forwarded
# to the CLI with --plan, which prints what it would do and writes nothing.
User=svc_mcprun
Group=svc_mcprun
# Needed only to read the service tree. The .env files stay unreadable: they are
# root:root 0600, which no supplementary group grants access to.
SupplementaryGroups=svc_apps svc_automation svc_infra svc_monitoring svc_network

# /usr/local/bin is root:root 755, so this stays a trustworthy target whichever
# installer put it there. Pointing at an installer-specific venv path would
# break the unit the day the installer changes.
ExecStart=/usr/local/bin/clixz-mcpd
Environment=CLIXZ_BIN=/usr/local/bin/clixz
Environment=CLIXZ_MCPD_SOCKET=/run/clixz-mcpd/clixz-mcpd.sock
Environment=PYTHONUNBUFFERED=1

RuntimeDirectory=clixz-mcpd
RuntimeDirectoryMode=0750
# Not a detail: this directory is bind-mounted into the MCP container. Systemd's
# default removes and recreates it on every restart, which leaves the container's
# mount pointing at a deleted inode — the socket then vanishes from inside the
# container, silently, until the container itself is recreated.
RuntimeDirectoryPreserve=yes

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

# Reads the tree; writes nowhere. This is the line that makes the daemon safe to
# expose: even a full compromise of the process cannot modify a service.
ReadOnlyPaths=/srv/docker /etc/clixz

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
