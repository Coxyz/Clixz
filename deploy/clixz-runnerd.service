[Unit]
Description=clixz gateway for the MCP server (read-only, relays mutations)
Documentation=file:/opt/repos/clixz-cli/deploy/README.md
After=network.target clixz-admind.socket
Wants=clixz-admind.socket

[Service]
Type=simple
# Unprivileged on purpose. svc_mcprun holds no supplementary privilege — in
# particular neither sudo nor docker — and must not gain any: an escape here
# should yield read access and nothing more. It needs the svc_* groups only to
# read the service tree; .env files stay unreadable (root:root, ACL docker:r).
User=svc_mcprun
Group=svc_mcprun
SupplementaryGroups=svc_apps svc_automation svc_infra svc_monitoring svc_network

ExecStart=/opt/pipx/venvs/clixz/bin/clixz-runnerd
Environment=CLIXZ_RUNNER_SOCKET=/run/clixz-runner/clixz-runner.sock
Environment=CLIXZ_ADMIN_SOCKET=/run/clixz-admin/clixz-admin.sock
Environment=PYTHONUNBUFFERED=1

# /run/clixz-runner, created by systemd. 0750 so the MCP container (which
# carries the svc_mcprun GID) can traverse and open the socket without being
# able to create anything in the directory.
RuntimeDirectory=clixz-runner
RuntimeDirectoryMode=0750
# Preserve is not a detail: this directory is bind-mounted into the MCP
# container. Systemd's default removes and recreates it on every restart, which
# leaves the container's mount pointing at a deleted inode — the socket then
# vanishes from inside the container, silently and permanently, until the
# container itself is recreated. Preserving keeps the inode stable.
RuntimeDirectoryPreserve=yes

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

# Reads the service tree; writes nothing. Mutations go through admind.
ReadOnlyPaths=/srv/docker /etc/clixz

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
