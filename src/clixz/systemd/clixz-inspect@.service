# Installed by `sudo clixz daemon install` from the clixz package.
[Unit]
Description=clixz-inspect: one read of the running containers for clixz-mcpd
CollectMode=inactive-or-failed

[Service]
# One request on stdin, one answer on stdout; both are the connection. It reads
# dockerd in GET only, filters what it read (no environment value, no command
# line), and gives logs only for the services listed in config.yaml's
# docker.logs. Every field of the request is checked again here.
ExecStart=/usr/local/bin/clixz-inspect
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=60
Environment=PYTHONUNBUFFERED=1

# Its one privilege is the docker group, for /run/docker.sock — which is root
# on the host whatever else is taken away, hence a process per request and
# GET only in the code. A dynamic account rather than root: it reads none of
# root's files (/etc/shadow, the .env, komodo.yaml) and owns nothing.
DynamicUser=yes
SupplementaryGroups=docker
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# No network at all: dockerd is a Unix socket on the filesystem, which a
# private network namespace does not hide.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
MemoryMax=192M
TasksMax=16
